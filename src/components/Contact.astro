---
const steps = [
  { n: '01', title: 'Review', text: 'We review your inquiry and project requirements within 1–2 business days.' },
  { n: '02', title: 'Discovery Call', text: 'A focused call to understand your goals, users, and technical needs.' },
  { n: '03', title: 'Proposal & Roadmap', text: 'A clear proposal with scope, timeline, and a step-by-step delivery roadmap.' },
];

const services = ['UI/UX Design', 'Static Web', 'Dynamic Web', 'Full-Stack'];
const budgets = [
  'Under $2,500',
  '$2,500 – $5,000',
  '$5,000 – $10,000',
  '$10,000 – $25,000',
  '$25,000+',
  'Not sure yet',
];
---

<section id="contact" class="relative py-20 sm:py-28">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <div class="grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:gap-16">
      <!-- Left: channels + process -->
      <div>
        <p class="text-xs font-bold uppercase tracking-[0.2em] text-brand-600">Contact / Consultation</p>
        <h2 class="mt-3 text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl">
          Let's build something luminous
        </h2>
        <p class="mt-4 text-lg text-slate-600">
          Tell us about your project — we'll reply with clear next steps and an
          honest point of view on the right approach.
        </p>

        <div class="mt-6 grid max-w-md gap-3">
          <a
            href="mailto:contact@luminacreative.tech"
            class="inline-flex min-w-0 items-center gap-3 rounded-2xl border border-slate-200 bg-white px-4 py-4 shadow-sm transition hover:border-brand-300 hover:shadow-md sm:px-5"
          >
            <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-brand-50 text-brand-600">
              <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.7">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l9 6 9-6M5 5h14a2 2 0 012 2v10a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2z" />
              </svg>
            </span>
            <span class="min-w-0 flex-1">
              <span class="block text-xs font-semibold uppercase tracking-wide text-slate-400">Email us directly</span>
              <span class="block break-words text-sm font-bold text-slate-800">contact@luminacreative.tech</span>
            </span>
          </a>

          <a
            href="https://wa.me/6287762951844?text=Hi%20Lumina%20Creative%20Studio%2C%20I%20would%20like%20to%20discuss%20a%20project."
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex min-w-0 items-center gap-3 rounded-2xl border border-slate-200 bg-white px-4 py-4 shadow-sm transition hover:border-emerald-300 hover:shadow-md sm:px-5"
          >
            <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-emerald-50 text-emerald-600">
              <svg class="h-6 w-6" viewBox="0 0 24 24" fill="currentColor">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
              </svg>
            </span>
            <span class="min-w-0 flex-1">
              <span class="block text-xs font-semibold uppercase tracking-wide text-slate-400">Chat on WhatsApp</span>
              <span class="block break-words text-sm font-bold text-slate-800">+62 877-6295-1844</span>
            </span>
          </a>
        </div>

        <div class="mt-10">
          <h3 class="text-sm font-bold uppercase tracking-wide text-slate-500">How we work — next steps</h3>
          <ol class="mt-5 space-y-4">
            {
              steps.map((s) => (
                <li class="flex items-start gap-4">
                  <span class="font-script text-3xl leading-none text-brand-500">{s.n}</span>
                  <div>
                    <p class="font-bold text-slate-900">{s.title}</p>
                    <p class="text-sm text-slate-600">{s.text}</p>
                  </div>
                </li>
              ))
            }
          </ol>
        </div>
      </div>

      <!-- Right: form -->
      <div class="rounded-[2rem] border border-slate-200 bg-white p-6 shadow-xl shadow-brand-900/5 sm:p-10">
        <form id="contact-form" class="space-y-5">
          <!-- Honeypot anti-spam -->
          <div class="hidden" aria-hidden="true">
            <label for="website">Leave this field empty</label>
            <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
          </div>

          <div class="grid gap-5 sm:grid-cols-2">
            <div>
              <label for="name" class="mb-1.5 block text-sm font-semibold text-slate-700">Full Name *</label>
              <input
                id="name"
                name="name"
                type="text"
                required
                placeholder="Jane Doe"
                class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm text-slate-800 outline-none transition placeholder:text-slate-400 focus:border-brand-500 focus:ring-4 focus:ring-brand-100"
              />
            </div>
            <div>
              <label for="email" class="mb-1.5 block text-sm font-semibold text-slate-700">Email Address *</label>
              <input
                id="email"
                name="email"
                type="email"
                required
                placeholder="jane@company.com"
                class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm text-slate-800 outline-none transition placeholder:text-slate-400 focus:border-brand-500 focus:ring-4 focus:ring-brand-100"
              />
            </div>
          </div>

          <div>
            <label for="company" class="mb-1.5 block text-sm font-semibold text-slate-700">Company / Organization</label>
            <input
              id="company"
              name="company"
              type="text"
              placeholder="Company Inc."
              class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm text-slate-800 outline-none transition placeholder:text-slate-400 focus:border-brand-500 focus:ring-4 focus:ring-brand-100"
            />
          </div>

          <fieldset>
            <legend class="mb-2 block text-sm font-semibold text-slate-700">Service Required *</legend>
            <div class="grid grid-cols-2 gap-3">
              {
                services.map((s) => (
                  <label class="flex cursor-pointer items-center gap-2.5 rounded-xl border border-slate-300 px-4 py-3 text-sm font-medium text-slate-700 transition has-[:checked]:border-brand-500 has-[:checked]:bg-brand-50 has-[:checked]:text-brand-800">
                    <input
                      type="checkbox"
                      name="service"
                      value={s}
                      class="h-4 w-4 rounded border-slate-300 text-brand-600 accent-brand-600"
                    />
                    {s}
                  </label>
                ))
              }
            </div>
          </fieldset>

          <div>
            <label for="budget" class="mb-1.5 block text-sm font-semibold text-slate-700">Estimated Budget Range</label>
            <select
              id="budget"
              name="budget"
              class="w-full appearance-none rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm text-slate-800 outline-none transition focus:border-brand-500 focus:ring-4 focus:ring-brand-100"
            >
              <option value="" selected disabled>Select a range…</option>
              {
                budgets.map((b) => <option value={b}>{b}</option>)
              }
            </select>
          </div>

          <div>
            <label for="message" class="mb-1.5 block text-sm font-semibold text-slate-700">Project Details / Message *</label>
            <textarea
              id="message"
              name="message"
              rows="5"
              required
              placeholder="Tell us about your goals, timeline, and any requirements…"
              class="w-full resize-y rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm text-slate-800 outline-none transition placeholder:text-slate-400 focus:border-brand-500 focus:ring-4 focus:ring-brand-100"
            ></textarea>
          </div>

          <button
            type="submit"
            class="inline-flex w-full items-center justify-center gap-2 rounded-full bg-brand-600 px-7 py-3.5 text-sm font-semibold text-white shadow-lg shadow-brand-600/30 transition hover:-translate-y-0.5 hover:bg-brand-700 sm:w-auto"
          >
            Send Consultation Request
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z" />
            </svg>
          </button>

          <p id="form-status" class="hidden rounded-xl bg-brand-50 px-4 py-3 text-sm font-semibold text-brand-800"></p>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  // Get a free access key at https://web3forms.com (it takes ~30 seconds).
  // Paste your key below to send form submissions straight to contact@luminacreative.tech.
  // Leave the placeholder as-is and the button falls back to opening the visitor's email app.
  const ACCESS_KEY = '675a1fc9-da98-4f1d-933d-28b54eac02c0';

  const form = document.getElementById('contact-form');
  const status = document.getElementById('form-status');
  const submitBtn = form?.querySelector('button[type="submit"]');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    // Honeypot: if a bot filled the hidden field, silently drop the submission.
    const honeypot = document.getElementById('website') as HTMLInputElement | null;
    if (honeypot && honeypot.value.trim() !== '') {
      return;
    }

    const data = new FormData(form as HTMLFormElement);
    const services = (data.getAll('service') as string[]).join(', ') || 'Not specified';
    const subject = `Consultation request — ${services}`;
    const body =
      `Name: ${data.get('name')}\n` +
      `Email: ${data.get('email')}\n` +
      `Company: ${data.get('company') || '—'}\n` +
      `Services: ${services}\n` +
      `Budget: ${data.get('budget') || '—'}\n\n` +
      `${data.get('message')}`;

    const hasAccessKey = ACCESS_KEY && !ACCESS_KEY.startsWith('YOUR_');

    if (status) {
      status.textContent = hasAccessKey
        ? 'Sending your message…'
        : 'Opening your email app…';
      status.classList.remove('hidden');
      status.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }

    if (hasAccessKey) {
      if (submitBtn) submitBtn.disabled = true;

      const payload = new FormData();
      payload.append('access_key', ACCESS_KEY);
      payload.append('subject', subject);
      payload.append('from_name', String(data.get('name') || ''));
      payload.append('email', String(data.get('email') || ''));
      payload.append('Company', String(data.get('company') || ''));
      payload.append('Services', services);
      payload.append('Budget', String(data.get('budget') || ''));
      payload.append('message', body);

      try {
        const res = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          body: payload,
          headers: { Accept: 'application/json' },
        });
        const json = await res.json();
        if (json && json.success) {
          if (status) {
            status.textContent =
              "Thanks! Your message has been sent — we'll be in touch within 1–2 business days.";
          }
          (form as HTMLFormElement).reset();
        } else {
          if (status) {
            status.textContent =
              'Something went wrong. Please email us directly at contact@luminacreative.tech.';
          }
        }
      } catch {
        if (status) {
          status.textContent =
            'Network error. Please email us directly at contact@luminacreative.tech.';
        }
      } finally {
        if (submitBtn) submitBtn.disabled = false;
      }
    } else {
      window.location.href = `mailto:contact@luminacreative.tech?subject=${encodeURIComponent(
        subject
      )}&body=${encodeURIComponent(body)}`;
    }
  });
</script>
