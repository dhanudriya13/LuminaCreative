---
import { siteConfig, whatsappUrl } from '../config/site';
import { homeContent } from '../content/home';
import Button from './ui/Button.astro';
import CheckboxCard from './ui/CheckboxCard.astro';
import Container from './ui/Container.astro';
import Field from './ui/Field.astro';
import Input from './ui/Input.astro';
import Select from './ui/Select.astro';
import Textarea from './ui/Textarea.astro';

const content = homeContent.contact;
const form = content.form;
const subjectPrefix = 'Consultation request';
---

<section id="contact" class="relative py-20 sm:py-28">
  <Container>
    <div class="grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:gap-16">
      <div>
        <p class="text-xs font-bold uppercase tracking-[0.2em] text-brand-600">{content.eyebrow}</p>
        <h2 class="mt-3 text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl">
          {content.heading}
        </h2>
        <p class="mt-4 text-lg text-slate-600">
          {content.intro}
        </p>

        <div class="mt-6 grid max-w-md gap-3">
          <a
            href={`mailto:${siteConfig.email}`}
            class="inline-flex min-w-0 items-center gap-3 rounded-2xl border border-slate-200 bg-white px-4 py-4 shadow-sm transition hover:border-brand-300 hover:shadow-md sm:px-5"
          >
            <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-brand-50 text-brand-600">
              <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l9 6 9-6M5 5h14a2 2 0 012 2v10a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2z" />
              </svg>
            </span>
            <span class="min-w-0 flex-1">
              <span class="block text-xs font-semibold uppercase tracking-wide text-slate-400">{content.emailLabel}</span>
              <span class="block break-words text-sm font-bold text-slate-800">{siteConfig.email}</span>
            </span>
          </a>

          <a
            href={whatsappUrl()}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex min-w-0 items-center gap-3 rounded-2xl border border-slate-200 bg-white px-4 py-4 shadow-sm transition hover:border-emerald-300 hover:shadow-md sm:px-5"
          >
            <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-emerald-50 text-emerald-600">
              <svg class="h-6 w-6" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
              </svg>
            </span>
            <span class="min-w-0 flex-1">
              <span class="block text-xs font-semibold uppercase tracking-wide text-slate-400">{content.whatsappLabel}</span>
              <span class="block break-words text-sm font-bold text-slate-800">{siteConfig.phone.display}</span>
            </span>
          </a>
        </div>

        <div class="mt-10">
          <h3 class="text-sm font-bold uppercase tracking-wide text-slate-500">{content.stepsHeading}</h3>
          <ol class="mt-5 space-y-4">
            {
              content.steps.map((step) => (
                <li class="flex items-start gap-4">
                  <span class="font-script text-3xl leading-none text-brand-500">{step.number}</span>
                  <div>
                    <p class="font-bold text-slate-900">{step.title}</p>
                    <p class="text-sm text-slate-600">{step.text}</p>
                  </div>
                </li>
              ))
            }
          </ol>
        </div>
      </div>

      <div class="rounded-[2rem] border border-slate-200 bg-white p-6 shadow-xl shadow-brand-900/5 sm:p-10">
        <form
          id="contact-form"
          class="space-y-5"
          data-sending={form.sending}
          data-success={form.success}
          data-error={form.error}
          data-network-error={form.networkError}
          data-email-fallback={form.emailFallback}
          data-service-required={form.serviceRequired}
          data-email={siteConfig.email}
          data-subject-prefix={subjectPrefix}
        >
          <div class="hidden" aria-hidden="true">
            <label for="website">Leave this field empty</label>
            <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
          </div>

          <div class="grid gap-5 sm:grid-cols-2">
            <Field htmlFor="name" label={form.name} required>
              <Input id="name" name="name" placeholder={form.namePlaceholder} required autocomplete="name" />
            </Field>
            <Field htmlFor="email" label={form.email} required>
              <Input id="email" name="email" type="email" placeholder={form.emailPlaceholder} required autocomplete="email" />
            </Field>
          </div>

          <div class="grid gap-5 sm:grid-cols-2">
            <Field htmlFor="company" label={form.company}>
              <Input id="company" name="company" placeholder={form.companyPlaceholder} autocomplete="organization" />
            </Field>
            <Field htmlFor="country" label={form.country} required>
              <Input id="country" name="country" placeholder={form.countryPlaceholder} required autocomplete="country-name" />
            </Field>
          </div>

          <fieldset>
            <legend class="field-label">
              {form.services}
              <span class="text-danger" aria-hidden="true"> *</span>
            </legend>
            <div class="grid gap-3 sm:grid-cols-2">
              {
                form.serviceOptions.map((service, index) => (
                  <CheckboxCard
                    name="service"
                    value={service}
                    id={`service-${index}`}
                  />
                ))
              }
            </div>
          </fieldset>

          <div class="grid gap-5 sm:grid-cols-2">
            <Field htmlFor="budget" label={form.budget}>
              <Select id="budget" name="budget">
                <option value="" selected disabled>{form.budgetPlaceholder}</option>
                {form.budgetOptions.map((option) => <option value={option}>{option}</option>)}
              </Select>
            </Field>

            <Field htmlFor="preferred-contact" label={form.preferredContact}>
              <Select id="preferred-contact" name="preferredContact">
                <option value="" selected disabled>{form.preferredContactPlaceholder}</option>
                {form.preferredContactOptions.map((option) => <option value={option}>{option}</option>)}
              </Select>
            </Field>
          </div>

          <Field htmlFor="message" label={form.message} required>
            <Textarea id="message" name="message" placeholder={form.messagePlaceholder} required />
          </Field>

          <div class="flex items-start gap-3">
            <input
              id="privacy"
              name="privacyConsent"
              type="checkbox"
              required
              class="mt-1 h-4 w-4 rounded border-slate-300 text-brand-600 accent-brand-600"
            />
            <label for="privacy" class="text-sm text-slate-600">
              {form.privacy}
              <span class="text-danger" aria-hidden="true"> *</span>
            </label>
          </div>

          <Button type="submit" class="w-full sm:w-auto">
            <span id="submit-label">{form.submit}</span>
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z" />
            </svg>
          </Button>

          <p
            id="form-status"
            class="hidden rounded-xl bg-brand-50 px-4 py-3 text-sm font-semibold text-brand-800"
            role="status"
            aria-live="polite"
          ></p>
        </form>
      </div>
    </div>
  </Container>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const status = document.getElementById('form-status');
  const submitButton = form?.querySelector('button[type="submit"]') as HTMLButtonElement | null;
  const submitLabel = document.getElementById('submit-label');
  const originalSubmitLabel = submitLabel?.textContent ?? '';

  const accessKey = import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY;
  const messages = {
    sending: form?.dataset.sending ?? '',
    success: form?.dataset.success ?? '',
    error: form?.dataset.error ?? '',
    networkError: form?.dataset.networkError ?? '',
    emailFallback: form?.dataset.emailFallback ?? '',
    serviceRequired: form?.dataset.serviceRequired ?? '',
    email: form?.dataset.email ?? '',
    subjectPrefix: form?.dataset.subjectPrefix ?? 'Consultation request',
  };

  function showStatus(message: string) {
    if (!status) return;

    status.textContent = message;
    status.classList.remove('hidden');
    status.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();

    const honeypot = document.getElementById('website') as HTMLInputElement | null;
    if (honeypot && honeypot.value.trim() !== '') {
      return;
    }

    const serviceInputs = Array.from(
      form.querySelectorAll<HTMLInputElement>('input[name="service"]'),
    );

    if (!serviceInputs.some((input) => input.checked)) {
      serviceInputs[0]?.setCustomValidity(messages.serviceRequired);
      serviceInputs[0]?.reportValidity();
      serviceInputs[0]?.focus();
      return;
    }

    serviceInputs[0]?.setCustomValidity('');

    const data = new FormData(form);
    const services = data.getAll('service').join(', ') || 'N/A';
    const subject = `${messages.subjectPrefix}: ${services}`;
    const body =
      `Name: ${data.get('name')}\n` +
      `Email: ${data.get('email')}\n` +
      `Company: ${data.get('company') || 'N/A'}\n` +
      `Country: ${data.get('country')}\n` +
      `Services: ${services}\n` +
      `Budget: ${data.get('budget') || 'N/A'}\n` +
      `Preferred contact: ${data.get('preferredContact') || 'N/A'}\n\n` +
      `${data.get('message')}`;

    const hasAccessKey = Boolean(accessKey && !accessKey.startsWith('YOUR_'));

    showStatus(hasAccessKey ? messages.sending : messages.emailFallback);

    if (!hasAccessKey) {
      window.location.href = `mailto:${messages.email}?subject=${encodeURIComponent(
        subject,
      )}&body=${encodeURIComponent(body)}`;
      return;
    }

    if (submitButton) submitButton.disabled = true;
    if (submitLabel) submitLabel.textContent = messages.sending;

    const payload = new FormData();
    payload.append('access_key', accessKey);
    payload.append('subject', subject);
    payload.append('from_name', String(data.get('name') || ''));
    payload.append('email', String(data.get('email') || ''));
    payload.append('Company', String(data.get('company') || ''));
    payload.append('Country', String(data.get('country') || ''));
    payload.append('Services', services);
    payload.append('Budget', String(data.get('budget') || ''));
    payload.append('Preferred contact', String(data.get('preferredContact') || ''));
    payload.append('message', body);

    try {
      const response = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        body: payload,
        headers: { Accept: 'application/json' },
      });
      const json = await response.json();

      if (json && json.success) {
        showStatus(messages.success);
        form.reset();
      } else {
        showStatus(messages.error);
      }
    } catch {
      showStatus(messages.networkError);
    } finally {
      if (submitButton) submitButton.disabled = false;
      if (submitLabel) submitLabel.textContent = originalSubmitLabel;
    }
  });
</script>
