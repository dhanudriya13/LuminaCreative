---
import { homeContent } from '../content/home';
import Button from './ui/Button.astro';
import Container from './ui/Container.astro';

const content = homeContent.hero;

---

<section id="home" class="relative overflow-hidden bg-gradient-to-b from-brand-50/80 via-white to-white">
  <div class="glow left-[-8rem] top-[-6rem] h-96 w-96 bg-brand-300/60"></div>
  <div class="glow right-[-6rem] top-24 h-80 w-80 bg-brand-200/70"></div>
  <div class="dot-grid absolute inset-0 opacity-60 [mask-image:linear-gradient(to_bottom,black,transparent_85%)]"></div>

  <Container class="relative grid items-center gap-14 pb-20 pt-32 lg:grid-cols-[1.05fr_0.95fr] lg:pb-28 lg:pt-40">
    <div class="animate-fade-up">
      <h1 class="mt-6 text-4xl font-extrabold leading-[1.08] tracking-tight text-slate-900 sm:text-5xl xl:text-6xl">
        {content.headline}
      </h1>

      <p class="mt-6 max-w-xl text-lg leading-relaxed text-slate-600">
        {content.supporting}
      </p>

      <div class="mt-8 flex flex-wrap items-center gap-4">
        <Button href={'/#contact'} size="lg">
          {content.primaryCta}
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5-5 5M6 12h12" />
          </svg>
        </Button>
        <Button href={'/#work'} variant="secondary" size="lg">
          {content.secondaryCta}
        </Button>
      </div>

      <p class="mt-8 flex items-center gap-2 text-sm font-semibold text-slate-500">
        <span class="inline-block h-1.5 w-1.5 rounded-full bg-brand-500"></span>
        {content.promise}
      </p>
    </div>

    <div class="animate-fade-up delay-2 relative mx-auto w-full max-w-md lg:max-w-none">
      <div class="relative z-10 rounded-[2rem] border border-white/60 bg-white/90 p-8 shadow-2xl shadow-brand-900/10 ring-1 ring-slate-200/60 backdrop-blur">
        <div class="mb-4 flex items-center justify-between">
          <span class="inline-flex items-center gap-1.5 rounded-full bg-brand-50 px-3 py-1 text-xs font-bold uppercase tracking-wider text-brand-700">
            <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 2c.5 5.2 2.6 7.6 7.8 8.2-5.2.6-7.3 2.9-7.8 8.2-.5-5.3-2.6-7.6-7.8-8.2C9.4 9.6 11.5 7.2 12 2z" />
            </svg>
            {content.brandLabel}
          </span>
        </div>

        <img
          src="/lumina-logo.png"
          alt={content.imageAlt}
          class="mx-auto w-full max-w-sm"
          width="1859"
          height="1061"
        />

        <p class="mt-2 text-center font-script text-2xl text-brand-500">
          {content.brandCaption}
        </p>
      </div>

      <div class="absolute -left-4 top-10 z-20 hidden rounded-2xl border border-slate-100 bg-white px-4 py-3 shadow-xl shadow-brand-900/10 sm:block">
        <p class="text-xs font-semibold text-slate-400">{content.focusLabel}</p>
        <p class="text-sm font-bold text-slate-800">{content.focusValue}</p>
      </div>
    </div>
  </Container>
</section>
