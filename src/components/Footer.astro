---

<footer class="bg-brand-950 pt-16 text-brand-100/70">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <div class="grid gap-10 pb-12 md:grid-cols-[1.2fr_1fr_1fr]">
      <div>
        <img
          src="/lumina-logo-white.png"
          alt="Lumina Creative Studio"
          class="h-14 w-auto"
          width="186"
          height="106"
        />
        <p class="mt-5 max-w-sm text-sm leading-relaxed">
          IT consultancy specializing in human-centered UI/UX design and
          end-to-end web development — for static and dynamic architectures.
        </p>
        <div class="mt-6 flex gap-3">
          {
            socials.map((s) => (
              <a
                href={s.href}
                aria-label={s.name}
                class="flex h-10 w-10 items-center justify-center rounded-full border border-white/10 bg-white/5 text-brand-100/70 transition hover:border-brand-400/50 hover:bg-brand-600 hover:text-white"
              >
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor">
                  <path d={s.icon} />
                </svg>
              </a>
            ))
          }
        </div>
      </div>

      <div>
        <h3 class="text-sm font-bold uppercase tracking-wide text-white">Explore</h3>
        <ul class="mt-4 space-y-2.5">
          {
            links.map((l) => (
              <li>
                <a href={l.href} class="text-sm transition hover:text-white">
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h3 class="text-sm font-bold uppercase tracking-wide text-white">Get in touch</h3>
        <ul class="mt-4 space-y-2.5 text-sm">
          <li>
            <a href="mailto:contact@luminacreative.tech" class="transition hover:text-white">
              contact@luminacreative.tech
            </a>
          </li>
          <li>
            <a href="https://wa.me/6287762951844" target="_blank" rel="noopener noreferrer" class="transition hover:text-white">
              WhatsApp: +62 877-6295-1844
            </a>
          </li>
          <li>
            <a href="https://glowcare-flax.vercel.app/" target="_blank" rel="noopener noreferrer" class="transition hover:text-white">
              Featured work — Glow &amp; Grace
            </a>
          </li>
          <li>
            <a href="#contact" class="transition hover:text-white">
              Book a consultation →
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="flex flex-col items-center justify-between gap-3 border-t border-white/10 py-6 text-sm sm:flex-row">
      <p>© {year} Lumina Creative Studio. All rights reserved.</p>
      <p class="font-script text-lg text-brand-300">Design with light, built to perform.</p>
    </div>
  </div>
</footer>
