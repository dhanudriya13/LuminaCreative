---
import { siteConfig, whatsappUrl } from '../config/site';
import { ui } from '../i18n/ui';
import Container from './ui/Container.astro';

const t = ui;
const year = new Date().getFullYear();

const links = [
  { label: t.nav.home, href: '/' },
  { label: t.nav.about, href: '/#about' },
  { label: t.nav.services, href: '/#services' },
  { label: t.nav.packages, href: '/#packages' },
  { label: t.nav.work, href: '/#work' },
  { label: t.nav.contact, href: '/#contact' },
];
---

<footer class="bg-brand-950 pt-16 text-brand-100/70">
  <Container>
    <div class="grid gap-10 pb-12 md:grid-cols-[1.2fr_1fr_1fr]">
      <div>
        <img
          src="/lumina-logo-white.png"
          alt="Lumina Creative Studio"
          class="h-14 w-auto"
          width="186"
          height="106"
        />
        <p class="mt-5 max-w-sm text-sm leading-relaxed">
          {t.footer.positioning}
        </p>

        {siteConfig.socials.length > 0 && (
          <div class="mt-6 flex gap-3">
            {siteConfig.socials.map((social) => (
              <a
                href={social.href}
                aria-label={social.name}
                rel="noopener noreferrer"
                class="flex h-10 w-10 items-center justify-center rounded-full border border-white/10 bg-white/5 text-brand-100/70 transition hover:border-brand-400/50 hover:bg-brand-600 hover:text-white"
              >
                <span class="text-xs font-bold">{social.name.slice(0, 1)}</span>
              </a>
            ))}
          </div>
        )}
      </div>

      <nav aria-label={t.a11y.footerNav}>
        <h3 class="text-sm font-bold uppercase tracking-wide text-white">{t.footer.explore}</h3>
        <ul class="mt-4 space-y-2.5">
          {
            links.map((link) => (
              <li>
                <a href={link.href} class="text-sm transition hover:text-white">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div>
        <h3 class="text-sm font-bold uppercase tracking-wide text-white">{t.footer.getInTouch}</h3>
        <ul class="mt-4 space-y-2.5 text-sm">
          <li>
            <a href={`mailto:${siteConfig.email}`} class="transition hover:text-white">
              {siteConfig.email}
            </a>
          </li>
          <li>
            <a
              href={whatsappUrl()}
              target="_blank"
              rel="noopener noreferrer"
              class="transition hover:text-white"
            >
              {t.footer.whatsapp}: {siteConfig.phone.display}
            </a>
          </li>
          <li>
            <a
              href="/#work"
              class="transition hover:text-white"
            >
              {t.footer.featuredWork}: Glow &amp; Grace
            </a>
          </li>
          <li>
            <a href="/#contact" class="transition hover:text-white">
              {t.cta.bookConsultation} →
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="flex flex-col items-center justify-between gap-3 border-t border-white/10 py-6 text-sm sm:flex-row">
      <p>© {year} {siteConfig.name}. {t.footer.rights}</p>
      <p class="font-script text-lg text-brand-300">{t.footer.tagline}</p>
    </div>
  </Container>
</footer>
