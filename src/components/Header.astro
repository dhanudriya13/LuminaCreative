---
import { ui } from '../i18n/ui';
import Container from './ui/Container.astro';

const t = ui;

const links = [
  { label: t.nav.home, href: '/' },
  { label: t.nav.about, href: '/#about' },
  { label: t.nav.services, href: '/#services' },
  { label: t.nav.packages, href: '/#packages' },
  { label: t.nav.work, href: '/#work' },
  { label: t.nav.contact, href: '/#contact' },
];

const isHome = Astro.url.pathname === '/';
---

<header
  id="site-header"
  class="fixed inset-x-0 top-0 z-50 border-b border-slate-200/70 bg-white/85 backdrop-blur-xl"
>
  <Container class="flex h-20 items-center justify-between gap-4">
    <a href="/" class="flex shrink-0 items-center gap-2" aria-label={`${t.nav.home}, Lumina Creative Studio`}>
      <img
        src="/lumina-logo.png"
        alt="Lumina Creative Studio"
        class="h-11 w-auto sm:h-12"
        width="186"
        height="106"
      />
    </a>

    <nav class="hidden items-center gap-1 lg:flex" aria-label={t.a11y.primaryNav}>
      {
        links.map((link) => (
          <a
            href={link.href}
            aria-current={isHome && link.href === '/' ? 'page' : undefined}
            class="rounded-full px-4 py-2 text-sm font-semibold text-slate-600 transition hover:bg-brand-50 hover:text-brand-700"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <a
        href="/#contact"
        class="hidden rounded-full bg-brand-600 px-5 py-2.5 text-sm font-semibold text-white shadow-lg shadow-brand-600/25 transition hover:-translate-y-0.5 hover:bg-brand-700 sm:inline-flex"
      >
        {t.cta.startProject}
      </a>

      <button
        id="menu-toggle"
        type="button"
        class="inline-flex h-11 w-11 items-center justify-center rounded-xl border border-slate-200 text-slate-700 transition hover:bg-brand-50 lg:hidden"
        aria-label={t.a11y.openMenu}
        data-open-label={t.a11y.openMenu}
        data-close-label={t.a11y.closeMenu}
        aria-controls="mobile-menu"
        aria-expanded="false"
      >
        <svg id="icon-open" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16" />
        </svg>
        <svg id="icon-close" class="hidden h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path stroke-linecap="round" d="M6 6l12 12M18 6L6 18" />
        </svg>
      </button>
    </div>
  </Container>

  <div id="mobile-menu" class="hidden border-t border-slate-200 bg-white px-5 pb-5 pt-2 lg:hidden">
    <nav class="flex flex-col" aria-label={t.a11y.mobileNav}>
      {
        links.map((link) => (
          <a
            href={link.href}
            class="rounded-xl px-3 py-3 text-base font-semibold text-slate-700 transition hover:bg-brand-50 hover:text-brand-700"
          >
            {link.label}
          </a>
        ))
      }

      <a
        href="/#contact"
        class="mt-4 rounded-full bg-brand-600 px-5 py-3 text-center text-sm font-semibold text-white shadow-lg shadow-brand-600/25"
      >
        {t.cta.startProject}
      </a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');

  const openLabel = toggle?.dataset.openLabel ?? 'Open navigation menu';
  const closeLabel = toggle?.dataset.closeLabel ?? 'Close navigation menu';

  function setMenu(open: boolean) {
    if (!menu || !toggle) return;

    menu.classList.toggle('hidden', !open);
    iconOpen?.classList.toggle('hidden', open);
    iconClose?.classList.toggle('hidden', !open);
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? closeLabel : openLabel);
  }

  toggle?.addEventListener('click', () => {
    const isOpen = menu?.classList.contains('hidden') === false;
    setMenu(!isOpen);
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && menu && !menu.classList.contains('hidden')) {
      setMenu(false);
      toggle?.focus();
    }
  });

  document.addEventListener('click', (event) => {
    if (!menu || menu.classList.contains('hidden')) return;

    const target = event.target as Node;
    if (!menu.contains(target) && !toggle?.contains(target)) {
      setMenu(false);
    }
  });

  menu?.querySelectorAll('a').forEach((link) =>
    link.addEventListener('click', () => setMenu(false)),
  );
</script>
