---
import { homeContent } from '../content/home';
import Badge from './ui/Badge.astro';
import Button from './ui/Button.astro';
import Card from './ui/Card.astro';
import Container from './ui/Container.astro';
import SectionHeading from './ui/SectionHeading.astro';

const content = homeContent.packages;
---

<section id="packages" class="relative overflow-hidden bg-gradient-to-b from-white via-brand-50/40 to-white py-20 sm:py-28">
  <div class="glow left-1/2 top-0 h-72 w-72 -translate-x-1/2 bg-brand-200/40"></div>

  <Container class="relative">
    <SectionHeading
      eyebrow={content.eyebrow}
      heading={content.heading}
      intro={content.intro}
    />

    <div class="mt-14 grid gap-6 lg:grid-cols-3 lg:items-stretch">
      {
        content.items.map((pkg) => (
          <Card
            as="article"
            class={pkg.recommended
              ? 'relative flex flex-col p-7 border-brand-500 shadow-xl ring-1 ring-brand-500/20 lg:-translate-y-2'
              : 'relative flex flex-col p-7'}
          >
            <div class="flex items-center justify-between gap-3">
              <span class="text-xs font-bold uppercase tracking-[0.2em] text-slate-400">
                {content.packageWord} {pkg.number}
              </span>
              {pkg.recommended && <Badge>{content.recommendedLabel}</Badge>}
            </div>

            <h3 class="mt-4 text-xl font-bold text-slate-900">{pkg.name}</h3>
            <p class="mt-2 text-2xl font-extrabold text-brand-700">{pkg.price}</p>
            {pkg.label && <p class="mt-1 text-sm font-semibold text-slate-500">{pkg.label}</p>}
            <p class="mt-4 text-sm text-slate-600">{pkg.description}</p>

            <ul class="mt-6 space-y-2.5 border-t border-slate-100 pt-6">
              {
                pkg.features.map((feature) => (
                  <li class="flex items-start gap-2.5 text-sm text-slate-600">
                    <svg class="mt-0.5 h-5 w-5 shrink-0 text-brand-500" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                      <path fill-rule="evenodd" d="M12 2a10 10 0 100 20 10 10 0 000-20zm4.7 7.3l-5.2 5.2a1 1 0 01-1.4 0L7.4 11.8a1 1 0 111.4-1.4l2 2 4.5-4.5a1 1 0 111.4 1.4z" clip-rule="evenodd" />
                    </svg>
                    {feature}
                  </li>
                ))
              }
            </ul>

            <div class="mt-auto pt-7">
              <Button
                href={'/#contact'}
                variant={pkg.recommended ? 'primary' : 'secondary'}
                class="w-full"
              >
                {content.cta}
              </Button>
            </div>
          </Card>
        ))
      }
    </div>

    <div class="mt-8 rounded-[var(--radius-card)] border border-slate-200 bg-white p-7 shadow-sm sm:p-9">
      <div class="grid gap-8 lg:grid-cols-[0.8fr_1.2fr] lg:items-center">
        <div>
          <p class="text-xs font-bold uppercase tracking-[0.2em] text-brand-600">
            {content.additionalLabel}
          </p>
          <h3 class="mt-3 text-2xl font-extrabold text-slate-900">{content.additional.name}</h3>
          <p class="mt-2 text-xl font-extrabold text-brand-700">{content.additional.price}</p>
        </div>

        <ul class="grid gap-3 sm:grid-cols-2">
          {
            content.additional.features.map((feature) => (
              <li class="flex items-start gap-2.5 text-sm text-slate-600">
                <svg class="mt-0.5 h-5 w-5 shrink-0 text-brand-500" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path fill-rule="evenodd" d="M12 2a10 10 0 100 20 10 10 0 000-20zm4.7 7.3l-5.2 5.2a1 1 0 01-1.4 0L7.4 11.8a1 1 0 111.4-1.4l2 2 4.5-4.5a1 1 0 111.4 1.4z" clip-rule="evenodd" />
                </svg>
                {feature}
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <p class="mt-6 text-center text-sm text-slate-500">
      {content.note}
    </p>
  </Container>
</section>
