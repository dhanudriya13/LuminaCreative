---
import { homeContent } from '../content/home';
import { ui } from '../i18n/ui';
import Badge from './ui/Badge.astro';
import Button from './ui/Button.astro';
import Container from './ui/Container.astro';
import SectionHeading from './ui/SectionHeading.astro';

const content = homeContent.work;
const t = ui;
---

<section id="work" class="relative py-20 sm:py-28">
  <Container>
    <SectionHeading
      eyebrow={content.eyebrow}
      heading={content.heading}
      intro={content.intro}
    />

    <div class="mt-14 space-y-8">
      {
        content.projects.map((project, index) => (
          <article class="grid overflow-hidden rounded-[2rem] border border-slate-200 bg-white shadow-xl shadow-brand-900/5 lg:grid-cols-2">
            <div
              class:list={[
                'relative flex min-h-[18rem] items-center justify-center overflow-hidden p-10',
                project.visual === 'glow'
                  ? 'bg-gradient-to-br from-brand-100 via-brand-50 to-rose-50'
                  : 'bg-gradient-to-br from-slate-100 via-white to-brand-50',
                index % 2 === 1 ? 'lg:order-2' : '',
              ]}
              aria-hidden="true"
            >
              <div class="dot-grid absolute inset-0 opacity-50"></div>

              {project.visual === 'glow' ? (
                <div class="relative rounded-3xl bg-white p-8 shadow-2xl shadow-brand-900/10 ring-1 ring-slate-200/60">
                  <p class="font-script text-center text-4xl text-brand-600">Glow</p>
                  <p class="mt-1 text-center text-[0.6rem] font-bold uppercase tracking-[0.35em] text-slate-400">
                    {project.subtitle}
                  </p>
                  <div class="mt-5 flex justify-center gap-2">
                    <span class="h-2 w-2 rounded-full bg-rose-300"></span>
                    <span class="h-2 w-2 rounded-full bg-brand-300"></span>
                    <span class="h-2 w-2 rounded-full bg-amber-300"></span>
                  </div>
                </div>
              ) : (
                <div class="relative w-full max-w-sm rounded-2xl bg-white p-6 shadow-2xl shadow-brand-900/10 ring-1 ring-slate-200/60">
                  <div class="flex items-center gap-1.5">
                    <span class="h-2 w-2 rounded-full bg-rose-300"></span>
                    <span class="h-2 w-2 rounded-full bg-amber-300"></span>
                    <span class="h-2 w-2 rounded-full bg-emerald-300"></span>
                  </div>
                  <p class="mt-5 font-script text-4xl text-brand-600">Dhanudriya</p>
                  <p class="mt-1 text-[0.6rem] font-bold uppercase tracking-[0.35em] text-slate-400">
                    {project.subtitle}
                  </p>
                  <div class="mt-5 space-y-2">
                    <div class="h-2 w-4/5 rounded-full bg-slate-100"></div>
                    <div class="h-2 w-3/5 rounded-full bg-slate-100"></div>
                    <div class="h-20 rounded-xl bg-gradient-to-br from-brand-50 to-slate-50"></div>
                  </div>
                  <p class="mt-4 text-center text-[0.65rem] font-bold uppercase tracking-[0.25em] text-slate-400">
                    dhanudriya.my.id
                  </p>
                </div>
              )}
            </div>

            <div
              class:list={[
                'flex flex-col justify-center p-8 sm:p-12',
                index % 2 === 1 ? 'lg:order-1' : '',
              ]}
            >
              <div class="flex flex-wrap gap-2">
                {index === 0 && <Badge>{content.featuredLabel}</Badge>}
                <Badge tone="neutral">{project.classification}</Badge>
              </div>

              <h3 class="mt-4 text-2xl font-extrabold text-slate-900 sm:text-3xl">
                {project.title}
              </h3>
              <p class="mt-1 text-sm font-semibold text-brand-600">{project.subtitle}</p>

              <p class="mt-3 text-slate-600">
                {project.description}
              </p>

              <div class="mt-6 space-y-5">
                <div>
                  <h4 class="text-sm font-bold uppercase tracking-wide text-brand-600">{project.challengeLabel}</h4>
                  <p class="mt-1.5 text-slate-600">{project.challenge}</p>
                </div>
                <div>
                  <h4 class="text-sm font-bold uppercase tracking-wide text-brand-600">{project.approachLabel}</h4>
                  <p class="mt-1.5 text-slate-600">{project.approach}</p>
                </div>
              </div>

              {project.technology.length > 0 && (
                <div class="mt-6">
                  <h4 class="text-sm font-bold uppercase tracking-wide text-brand-600">{project.technologyLabel}</h4>
                  <div class="mt-2 flex flex-wrap gap-2">
                    {project.technology.map((technology) => (
                      <span class="rounded-full border border-slate-200 bg-slate-50 px-3 py-1 text-xs font-semibold text-slate-600">
                        {technology}
                      </span>
                    ))}
                  </div>
                </div>
              )}

              <div class="mt-8 flex flex-wrap items-center gap-4">
                <Button href={project.url} target="_blank" rel="noopener noreferrer">
                  {project.primaryCta}
                  <span class="sr-only">({t.a11y.externalLink})</span>
                  <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M9 7h8v8" />
                  </svg>
                </Button>
                <a href={'/#contact'} class="text-sm font-bold text-brand-700 transition hover:text-brand-800">
                  {project.secondaryCta} →
                </a>
              </div>
            </div>
          </article>
        ))
      }
    </div>

    <p class="mt-6 text-center text-sm text-slate-500">
      {content.more}
    </p>
  </Container>
</section>
