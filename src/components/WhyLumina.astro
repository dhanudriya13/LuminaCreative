---
import { homeContent } from '../content/home';
import Container from './ui/Container.astro';
import SectionHeading from './ui/SectionHeading.astro';

const content = homeContent.why;
---

<section id="why" class="relative overflow-hidden bg-brand-950 py-20 sm:py-28">
  <div class="glow left-[-6rem] top-[-4rem] h-80 w-80 bg-brand-600/40"></div>
  <div class="glow bottom-[-6rem] right-[-4rem] h-96 w-96 bg-brand-500/30"></div>

  <Container class="relative">
    <div class="grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
      <div>
        <SectionHeading
          eyebrow={content.eyebrow}
          heading={content.heading}
          accent={content.headingAccent}
          intro={content.body}
          align="left"
          tone="dark"
        />

        <div class="mt-8 flex items-center gap-4 rounded-2xl border border-white/10 bg-white/5 p-5 backdrop-blur">
          <img
            src="/lumina-logo-white.png"
            alt="Lumina Creative Studio"
            class="h-12 w-auto opacity-90"
            width="186"
            height="106"
          />
          <p class="text-sm leading-snug text-brand-100/80">
            {content.note}
          </p>
        </div>
      </div>

      <div class="grid gap-5 sm:grid-cols-2">
        {
          content.pillars.map((pillar) => (
            <div class="rounded-2xl border border-white/10 bg-white/5 p-6 backdrop-blur transition hover:border-brand-400/40 hover:bg-white/10">
              <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-brand-600 text-white">
                <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M9 12l2 2 4-4M12 3l7 4v5c0 4-3 7-7 8-4-1-7-4-7-8V7l7-4z" />
                </svg>
              </div>
              <h3 class="mt-4 text-lg font-bold text-white">{pillar.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-brand-100/75">{pillar.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </Container>
</section>
