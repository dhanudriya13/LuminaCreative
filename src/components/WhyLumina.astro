---
const pillars = [
  {
    title: 'Systemic Architecture',
    text: 'We design information architectures and technical foundations that hold up as your business scales.',
    icon: 'M4 7h16M4 12h10M4 17h16',
  },
  {
    title: 'User-Centric Methodology',
    text: 'Every decision is grounded in research, usability testing, and an understanding of how people actually think.',
    icon: 'M12 21a9 9 0 100-18 9 9 0 000 18zM12 15a3 3 0 100-6 3 3 0 000 6z',
  },
  {
    title: 'End-to-End Execution',
    text: 'Strategy, design, development, and launch — one accountable team from discovery to delivery.',
    icon: 'M13 7l5 5-5 5M6 12h12',
  },
  {
    title: 'Rigorous Engineering',
    text: 'Clean code, measurable performance, and security best practices are non-negotiables in everything we ship.',
    icon: 'M9 12l2 2 4-4M12 3l7 4v5c0 4-3 7-7 8-4-1-7-4-7-8V7l7-4z',
  },
];
---

<section id="why" class="relative overflow-hidden bg-brand-950 py-20 sm:py-28">
  <div class="glow left-[-6rem] top-[-4rem] h-80 w-80 bg-brand-600/40"></div>
  <div class="glow bottom-[-6rem] right-[-4rem] h-96 w-96 bg-brand-500/30"></div>

  <div class="relative mx-auto max-w-7xl px-5 sm:px-8">
    <div class="grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
      <div>
        <p class="text-xs font-bold uppercase tracking-[0.2em] text-brand-300">Why Choose Lumina</p>
        <h2 class="mt-3 text-3xl font-extrabold tracking-tight text-white sm:text-4xl">
          Where psychology meets <span class="font-script text-brand-300">precision</span>
        </h2>
        <p class="mt-5 max-w-md text-lg leading-relaxed text-brand-100/80">
          We bridge human psychology and technical precision — translating
          business goals into interfaces people love and platforms that perform.
        </p>

        <div class="mt-8 flex items-center gap-4 rounded-2xl border border-white/10 bg-white/5 p-5 backdrop-blur">
          <img src="/lumina-logo-white.png" alt="Lumina Creative Studio" class="h-12 w-auto opacity-90" width="186" height="106" />
          <p class="text-sm leading-snug text-brand-100/80">
            Academic foundations in Information Systems &amp; Human-Computer
            Interaction, applied to commercial success.
          </p>
        </div>
      </div>

      <div class="grid gap-5 sm:grid-cols-2">
        {
          pillars.map((p) => (
            <div class="rounded-2xl border border-white/10 bg-white/5 p-6 backdrop-blur transition hover:border-brand-400/40 hover:bg-white/10">
              <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-brand-600 text-white">
                <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d={p.icon} />
                </svg>
              </div>
              <h3 class="mt-4 text-lg font-bold text-white">{p.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-brand-100/75">{p.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
