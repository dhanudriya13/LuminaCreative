---
interface Props {
  id: string;
  name: string;
  type?: string;
  value?: string;
  placeholder?: string;
  required?: boolean;
  autocomplete?: string;
  class?: string;
}

const {
  id,
  name,
  type = 'text',
  value,
  placeholder,
  required = false,
  autocomplete,
  class: className,
} = Astro.props;
---

<input
  id={id}
  name={name}
  type={type}
  value={value}
  placeholder={placeholder}
  required={required}
  autocomplete={autocomplete}
  class:list={['field-control', className]}
/>
