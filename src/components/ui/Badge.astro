---
interface Props {
  tone?: 'brand' | 'neutral' | 'dark';
  class?: string;
}

const { tone = 'brand', class: className } = Astro.props;

const tones = {
  brand: 'bg-brand-50 text-brand-700',
  neutral: 'border border-slate-200 bg-slate-50 text-slate-600',
  dark: 'border border-white/10 bg-white/5 text-brand-100',
};
---

<span
  class:list={[
    'inline-flex w-fit items-center gap-1.5 rounded-full px-3 py-1 text-xs font-bold uppercase tracking-wider',
    tones[tone],
    className,
  ]}
>
  <slot />
</span>
