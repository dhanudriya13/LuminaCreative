---
interface Props {
  id: string;
  name: string;
  rows?: number;
  placeholder?: string;
  required?: boolean;
  class?: string;
}

const {
  id,
  name,
  rows = 5,
  placeholder,
  required = false,
  class: className,
} = Astro.props;
---

<textarea
  id={id}
  name={name}
  rows={rows}
  placeholder={placeholder}
  required={required}
  class:list={['field-control resize-y', className]}
></textarea>
