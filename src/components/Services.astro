---
import { homeContent } from '../content/home';
import Card from './ui/Card.astro';
import Container from './ui/Container.astro';
import SectionHeading from './ui/SectionHeading.astro';

const content = homeContent.services;
---

<section id="services" class="relative py-20 sm:py-28">
  <Container>
    <SectionHeading
      eyebrow={content.eyebrow}
      heading={content.heading}
      intro={content.intro}
    />

    <div class="mt-14 grid gap-6 sm:grid-cols-2 xl:grid-cols-4">
      {
        content.items.map((service) => (
          <Card
            as="article"
            class="group relative flex flex-col p-7 transition duration-300 hover:-translate-y-1.5 hover:border-brand-200 hover:shadow-xl hover:shadow-brand-600/10"
          >
            <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-brand-600 text-white shadow-lg shadow-brand-600/25 transition group-hover:scale-105">
              {service.icon === 'code' && (
                <svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M8 9l-4 3 4 3m8-6l4 3-4 3M13 5l-2 14" />
                </svg>
              )}
              {service.icon === 'layers' && (
                <svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4 7l8-4 8 4-8 4-8-4zM4 12l8 4 8-4M4 17l8 4 8-4" />
                </svg>
              )}
              {service.icon === 'pen' && (
                <svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 19l7-7 3 3-7 7-3-3zM18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5zM2 2l7.586 7.586" />
                </svg>
              )}
              {service.icon === 'palette' && (
                <svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 3a9 9 0 100 18h1.5a1.5 1.5 0 000-3H12a2 2 0 010-4h4a5 5 0 005-5c0-3.5-4-6-9-6z" />
                  <circle cx="7.5" cy="10.5" r="1" fill="currentColor" stroke="none" />
                  <circle cx="10" cy="6.5" r="1" fill="currentColor" stroke="none" />
                  <circle cx="15" cy="7" r="1" fill="currentColor" stroke="none" />
                </svg>
              )}
            </div>

            <h3 class="mt-6 text-xl font-bold text-slate-900">{service.title}</h3>
            <p class="mt-3 text-slate-600">{service.summary}</p>

            <ul class="mt-6 space-y-2.5 border-t border-slate-100 pt-6">
              {
                service.points.map((point) => (
                  <li class="flex items-start gap-2.5 text-sm text-slate-600">
                    <svg class="mt-0.5 h-5 w-5 shrink-0 text-brand-500" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                      <path fill-rule="evenodd" d="M12 2a10 10 0 100 20 10 10 0 000-20zm4.7 7.3l-5.2 5.2a1 1 0 01-1.4 0L7.4 11.8a1 1 0 111.4-1.4l2 2 4.5-4.5a1 1 0 111.4 1.4z" clip-rule="evenodd" />
                    </svg>
                    {point}
                  </li>
                ))
              }
            </ul>

            <a
              href={'/#contact'}
              class="mt-7 inline-flex items-center gap-1.5 text-sm font-bold text-brand-700 transition group-hover:gap-2.5"
            >
              {content.cta}
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5-5 5M6 12h12" />
              </svg>
            </a>
          </Card>
        ))
      }
    </div>
  </Container>
</section>
